        "message": "=<div style=\"font-family: Arial, sans-serif; color: #1f2937; line-height: 1.5; \nmax-width: 720px;\"> \n<h2 style=\"margin-bottom: 8px; color: #111827;\"> \nAprovação de resposta da IA \n</h2> \n<p style=\"margin-top: 0; color: #4b5563;\"> \nUm novo ticket foi analisado pela inteligência artificial e precisa de \naprovação antes do envio ao cliente. \n</p> \n<hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;\"> \n<h3 style=\"color: #111827; margin-bottom: 10px;\"> \nDados do cliente \n</h3> \n<p> \n<b>Nome:</b> {{ $('NovoTicket').item.json.nome }}<br> \n<b>Email:</b> {{ $('NovoTicket').item.json.email }}<br> \n<b>Empresa:</b> {{ $('NovoTicket').item.json.empresa }}<br> \n<b>Plano:</b> {{ $('AgenteTriagem').item.json.output.plano_cliente }} \n</p> \n<h3 style=\"color: #111827; margin-bottom: 10px;\"> \nDetalhes do ticket \n</h3> \n<p> \n<b>Assunto:</b> {{ $('NovoTicket').item.json.assunto }}<br> \n<b>Categoria:</b> {{ $('AgenteTriagem').item.json.output.categoria }}<br> \n<b>Prioridade:</b> {{ $('AgenteTriagem').item.json.output.prioridade }}<br> \n<b>Equipe responsável:</b> {{ $('AgenteTriagem').item.json.output.equipe }} \n</p> \n<p> \n<b>Impacto identificado:</b><br> \n{{ $('AgenteTriagem').item.json.output.impacto }} \n</p> \n<p> \n<b>Resumo gerado pela IA:</b><br> \n{{ $('AgenteTriagem').item.json.output.resumo }} \n</p> \n<div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: \n8px; padding: 16px; margin: 20px 0;\"> \n<h3 style=\"margin-top: 0; color: #111827;\"> \nMensagem original do cliente \n</h3> \n<p style=\"margin-bottom: 0;\"> \n{{ $('NovoTicket').item.json.mensagem }} \n</p> \n</div> \n<div style=\"background: #ecfdf5; border: 1px solid #bbf7d0; border-radius: \n8px; padding: 16px; margin: 20px 0;\"> \n<h3 style=\"margin-top: 0; color: #065f46;\"> \nResposta sugerida pela IA \n</h3> \n{{ $('AgenteTriagem').item.json.output.resposta_cliente_html }} \n</div> \n<hr style=\"border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;\"> \n<p style=\"color: #4b5563;\"> \nRevise a resposta acima e escolha uma das opções: \n</p> \n</div> ",
